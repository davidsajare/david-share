# Copy to .env and fill in. Do NOT commit the filled-in file.
# Keep real keys out of any synced folder - prefer Entra ID over a key.
#
# Leave AZURE_OPENAI_API_KEY empty to authenticate with Entra ID
# (DefaultAzureCredential), which is what the studies used.
# With neither variable set the console still starts, in replay mode.

AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
