# Copy to /etc/qira-benchmark/portal.env on the Linux Work VM.
QIRA_RUNNER_URL=http://127.0.0.1:8514
QIRA_RUNNER_LABEL=Sweden Central runner
QIRA_HISTORY_DIR=/var/lib/qira-benchmark/history

# Exact browser origins allowed to submit state-changing requests. List every
# scheme actually served by nginx; never derive this value from the Host header.
QIRA_ALLOWED_ORIGIN=http://linuxworkvm1-work.eastasia.cloudapp.azure.com,https://linuxworkvm1-work.eastasia.cloudapp.azure.com
