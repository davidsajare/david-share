[Unit]
Description=Qira live benchmark portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qira-benchmark
Group=qira-benchmark
WorkingDirectory=/opt/qira-benchmark
EnvironmentFile=/etc/qira-benchmark/portal.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QIRA_HISTORY_DIR=/var/lib/qira-benchmark/history
Environment=QIRA_MAX_ACTIVE_RUNS=2
ExecStart=/opt/qira-benchmark/venv/bin/python server.py --host 127.0.0.1 --port 8513
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=qira-benchmark
StateDirectoryMode=0750
ReadWritePaths=/var/lib/qira-benchmark

[Install]
WantedBy=multi-user.target
