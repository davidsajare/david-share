# Evidence files are hashed byte-for-byte (see outputs/provenance_*.json);
# never let core.autocrlf rewrite their line endings on checkout.
*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.xz -text

# These executed sources are verified against the VM's byte-level provenance.
harness.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
judge.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
analyze.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
scripts/build_router_dataset.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
outputs/source_snapshot/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Shell scripts run on the Linux benchmark VM and must stay LF.
*.sh text eol=lf

# The builder regenerates this report with LF so a rebuild is byte-identical.
outputs/Qira-*.md text eol=lf
README*.md text eol=lf
