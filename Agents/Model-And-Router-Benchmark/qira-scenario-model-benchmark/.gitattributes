# Evidence files are hashed byte-for-byte (see outputs/provenance_*.json);
# never let core.autocrlf rewrite their line endings on checkout.
*.jsonl -text
*.xz -text

# Shell scripts run on the Linux benchmark VM and must stay LF.
*.sh text eol=lf

# The builder regenerates this report with LF so a rebuild is byte-identical.
outputs/Qira-*.md text eol=lf
