# Copy to /etc/benchmark/portal.env on the Linux Work VM.
BENCH_RUNNER_URL=http://127.0.0.1:8514
BENCH_RUNNER_LABEL=Sweden Central runner
BENCH_HISTORY_DIR=/var/lib/benchmark/history

# Exact browser origins allowed to submit state-changing requests. List every
# scheme actually served by nginx; never derive this value from the Host header.
BENCH_ALLOWED_ORIGIN=http://YOUR-PORTAL-HOST,https://YOUR-PORTAL-HOST
